{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Assets-only Worker for the static openza.org site. No bindings, no Worker code.
	"name": "openza-website",
	"compatibility_date": "2026-10-06",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"routes": [{ "pattern": "openza.org", "custom_domain": true }],
	"observability": { "enabled": false },
	"workers_dev": false,
	"preview_urls": false
}
