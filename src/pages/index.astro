---
import '@fontsource-variable/inter';
import '../styles/home.css';

const title = 'Openza Tasks — a calm, local-first task app';
const description =
	'Openza Tasks is a simple, local-first task app for Linux. Capture quickly, plan when it helps, and keep your tasks on your own computer. Free and open source.';

const features = [
	{
		title: 'Local first',
		body: 'Your tasks live in a database on your computer. No account, and it works offline.',
	},
	{
		title: 'Plan your way',
		body: 'Inbox, Next, Waiting For, and Someday when you want a method. A plain list when you do not.',
	},
	{
		title: 'Spaces, projects, labels',
		body: 'Keep work and home apart, group what belongs together, and tag across both.',
	},
	{
		title: 'Connected apps',
		body: 'Bring in Todoist and Microsoft To Do tasks, and send completions back.',
	},
	{
		title: 'Always recoverable',
		body: 'Automatic restore points, backup files, and optional encrypted OneDrive backups.',
	},
	{
		title: 'Scriptable',
		body: 'A command-line interface on the same tasks, and GitHub issues from any task.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL('/', Astro.site)} />
		<link rel="icon" href="/openza.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="color-scheme" content="light dark" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL('/', Astro.site)} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="top">
			<div class="wrap nav">
				<a class="brand" href="/" aria-label="Openza home">
					<img src="/openza.svg" alt="" width="28" height="28" />
					<span>Openza</span>
				</a>
				<nav aria-label="Main">
					<a href="/tasks/">Guide</a>
					<a href="/personal-cloud/">Personal Cloud</a>
					<a href="/privacy/">Privacy</a>
					<a href="https://github.com/openza/tasks">GitHub</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="wrap hero">
				<div class="hero-copy">
					<p class="eyebrow"><img src="/tasks.svg" alt="" width="20" height="20" /> Openza Tasks</p>
					<h1>A calm place for everything you need to do.</h1>
					<p class="lede">
						A simple, local-first task app. Capture in seconds, plan when it helps, and keep your tasks on
						your own computer.
					</p>
					<div class="actions">
						<a class="button primary" href="https://snapcraft.io/openza-tasks">Get it from the Snap Store</a>
						<a class="button" href="/tasks/">Read the guide</a>
					</div>
					<p class="install"><code>sudo snap install openza-tasks</code></p>
					<p class="platforms">
						Linux today. Windows from the <a href="https://apps.microsoft.com/detail/9NQGDKXGRGF8">Microsoft Store</a>,
						with an updated version in progress. macOS planned.
					</p>
				</div>

				<figure class="app" aria-label="Illustration of the Openza Tasks window with example tasks">
					<div class="app-bar" aria-hidden="true"><span></span><span></span><span></span></div>
					<div class="app-body">
						<ul class="app-nav" aria-hidden="true">
							<li class="active">Inbox <b>3</b></li>
							<li>Next Actions</li>
							<li>Today <b>2</b></li>
							<li>Calendar</li>
							<li>Waiting For</li>
							<li>Someday</li>
						</ul>
						<div class="app-list">
							<p class="app-title">Inbox</p>
							<ul>
								<li><i></i><div>Write down the next idea<small>Inbox</small></div></li>
								<li><i></i><div>Finish the first draft<small>Writing · Today</small></div></li>
								<li><i></i><div>Book a walk outside<small>Personal · Next</small></div></li>
								<li class="done"><i></i><div>Back up the laptop<small>Home · Completed</small></div></li>
							</ul>
						</div>
					</div>
					<figcaption>Example content</figcaption>
				</figure>
			</section>

			<section class="wrap features" aria-labelledby="features-title">
				<h2 id="features-title">Everything you need. Nothing you don't.</h2>
				<div class="grid">
					{
						features.map((feature) => (
							<article>
								<h3>{feature.title}</h3>
								<p>{feature.body}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="wrap cloud" aria-labelledby="cloud-title">
				<div>
					<p class="badge">Preview</p>
					<h2 id="cloud-title">Your tasks on the Web, in your own cloud.</h2>
					<p>
						Personal Cloud is an optional Web copy of your tasks, hosted in your own Cloudflare account. Openza never
						holds your tasks, and your desktop keeps working offline.
					</p>
					<a class="link" href="/personal-cloud/">How Personal Cloud works →</a>
				</div>
				<ol class="flow" aria-label="How Personal Cloud connects">
					<li><strong>Your desktop</strong><span>Local database and connected-app sign-ins</span></li>
					<li><strong>Your Cloudflare</strong><span>Your Web app and task copy</span></li>
					<li><strong>Your browser</strong><span>Passkey sign-in</span></li>
				</ol>
			</section>

			<section class="wrap promise" aria-label="Principles">
				<p><strong>No account.</strong> Start in seconds.</p>
				<p><strong>No tracking.</strong> No telemetry or analytics.</p>
				<p><strong>Open source.</strong> MIT licensed on GitHub.</p>
			</section>

			<section class="wrap more" aria-labelledby="more-title">
				<h2 id="more-title">Also from Openza</h2>
				<div class="more-grid">
					<a href="/reader/">
						<img src="/reader.svg" alt="" width="32" height="32" />
						<span><strong>Reader</strong> A focused Markdown reader for Windows.</span>
					</a>
					<a href="/flow/">
						<img src="/flow.svg" alt="" width="32" height="32" />
						<span><strong>Flow</strong> Agent sessions from Windows and WSL in one place.</span>
					</a>
				</div>
			</section>
		</main>

		<footer class="wrap foot">
			<p>Openza · Independent, open-source software by Deependra Solanky</p>
			<nav aria-label="Footer">
				<a href="/tasks/">Tasks guide</a>
				<a href="/personal-cloud/">Personal Cloud</a>
				<a href="/privacy/">Privacy</a>
				<a href="https://github.com/openza">GitHub</a>
			</nav>
		</footer>
	</body>
</html>
